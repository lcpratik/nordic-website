# Email for the contact form and waitlist, sent with Resend (resend.com).
# Set these in Vercel: Project > Settings > Environment Variables. Never commit real values.

# Required. Create it in Resend > API Keys (permission: "Sending access").
RESEND_API_KEY=

# The sender. Must be on a domain verified in Resend, for example:
#   Nordic Rooms & Apartments <hello@yourdomain.com>
# While this is empty (or uses @resend.dev), the hotel email still works only for the Resend account
# owner's address, and guest confirmation emails are switched off.
EMAIL_FROM=

# Where enquiries and waitlist signups are delivered. Defaults to the contact email in lib/site.ts.
HOTEL_NOTIFICATION_EMAIL=nordicroomandapartments@gmail.com
